{
  "name": "parqueadero-js",
  "version": "1.0.0",
  "main": "Main.js",
  "scripts": {
    "start": "electron . --remote-debugging-port=9222",
    "test": "node tests/run-tests.js",
    "test:unit": "jest tests/unit --verbose",
    "test:persistence": "jest tests/integration --verbose",
    "test:e2e": "jest tests/e2e --verbose --runInBand",
    "test:all": "node tests/run-tests.js --all"
  },
  "keywords": [
    "electron",
    "parking",
    "qa",
    "jest",
    "playwright"
  ],
  "author": "Kevin Angarita, Juan Bohorquez",
  "license": "ISC",
  "description": "Sistema de gestión y ventas para parqueadero - Parking La Primera con Suite de Pruebas QA",
  "devDependencies": {
    "asar": "^3.2.0",
    "electron": "^30.0.0",
    "electron-packager": "^17.1.2",
    "jest": "^29.7.0",
    "playwright": "^1.43.0",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "chromedriver": "^124.0.4",
    "selenium-webdriver": "^4.51.0"
  },
  "jest": {
    "testTimeout": 30000,
    "verbose": true
  }
}
